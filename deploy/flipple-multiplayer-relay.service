[Unit]
Description=Flipple Minecraft Multiplayer QUIC Relay
Documentation=https://github.com/douglasviniii/flipple-multiplayer-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flipple-relay
Group=flipple-relay
EnvironmentFile=/etc/flipple-multiplayer-relay/relay.env
ExecStart=/opt/flipple-multiplayer-relay/bin/flipple-multiplayer-relay
Restart=always
RestartSec=3s
TimeoutStopSec=15s
KillSignal=SIGTERM

# UDP 443 without running the process as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

LimitNOFILE=65536
TasksMax=256
MemoryMax=1G

[Install]
WantedBy=multi-user.target
