MULTIPLAYER_RELAY_BIND=0.0.0.0:443
MULTIPLAYER_RELAY_CERT=/etc/flipple-multiplayer-relay/tls/fullchain.pem
MULTIPLAYER_RELAY_KEY=/etc/flipple-multiplayer-relay/tls/privkey.pem
MULTIPLAYER_TICKET_KID=replace-with-public-key-id
MULTIPLAYER_TICKET_PUBLIC_KEY=replace-with-base64url-ed25519-public-key
RUST_LOG=info
